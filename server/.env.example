# Google Sheets Configuration
# Client ID + secret del cliente OAuth de Google Cloud (el mismo que usa n8n).
# El refresh token se obtiene una vez con: npm run get-refresh-token
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_REFRESH_TOKEN=obtained_via_get-refresh-token_script
GOOGLE_SHEETS_ID=1zkBNuc7F91UwJlqHP__SQrCdRCeaYos_z9VcIAM3Cms

# Nombres de pestañas (opcional, defaults mostrados)
# SHEETS_TAB_AGENCIAS=Agencias-Grid view
# SHEETS_TAB_AGENCIAS_BASE=Agencias BASE-Grid view
# SHEETS_TAB_COPYS=Copys-Grid view
# SHEETS_TAB_HISTORIAL=Historial
# SHEETS_TAB_USUARIOS=Usuarios

# Server Configuration
JWT_SECRET=your_secret_jwt_key_change_this_in_production
PORT=3006
NODE_ENV=development
